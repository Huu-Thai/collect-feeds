DATABASE_URL="postgresql://threat_feed:threat_feed@localhost:5432/threat_feed?schema=public"

REDIS_HOST="localhost"
REDIS_PORT="6379"
# Leave empty for no auth (matches docker-compose's default); set to require a password.
REDIS_PASSWORD=""

JWT_SECRET="change-me"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_TTL="7d"

# SMTP — defaults target a local dev catcher (e.g. MailHog/Maildev) on port 1025.
MAIL_HOST="localhost"
MAIL_PORT="1025"
MAIL_SECURE="false"
MAIL_USER=""
MAIL_PASSWORD=""
MAIL_FROM="Threat Feed <no-reply@threat-feed.local>"

# Used to build links in emails (e.g. password reset).
FRONTEND_URL="http://localhost:3000"

PORT="3000"
NODE_ENV="development"
